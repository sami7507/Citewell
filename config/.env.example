# Copy this file to the project root as ".env" and fill in your own values.
#   Windows (Anaconda Prompt):  copy config\.env.example .env
#   macOS / Linux:              cp config/.env.example .env
# Never commit .env itself.

# Groq API key. Free at https://console.groq.com/keys
# (You can also paste the key into the app's page instead of setting it here.)
GROQ_API_KEY=your_groq_api_key_here

# Language model served by Groq
GROQ_MODEL=openai/gpt-oss-120b

# Optional backup model, tried once if the main one fails. Leave empty to disable.
# Only use an id your Groq account can access (list yours: see the README).
# GROQ_FALLBACK_MODEL=

# Local embedding model (Hugging Face sentence-transformers id)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval. TOP_K=2 was chosen empirically on the sample corpus; uploads use UPLOAD_TOP_K.
TOP_K=2
UPLOAD_TOP_K=4

# Upload limits
MAX_UPLOAD_FILES=5
MAX_UPLOAD_MB=50

# Questions one visitor session may ask with the server's key (0 = unlimited).
# Visitors who paste their own key are never limited.
MAX_QUESTIONS_PER_SESSION=30

# Signed-in visitors get a higher cap, and sign-in can be made mandatory.
# Sign-in itself is configured in .streamlit/secrets.toml (see config/secrets.toml.example).
MAX_QUESTIONS_SIGNED_IN=100
REQUIRE_LOGIN=false

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional storage locations (relative paths are relative to the project root)
# SAMPLE_DOCS_DIR=storage/sample_docs
# VECTORSTORE_DIR=storage/index
# DATABASE_PATH=storage/citewell.db
