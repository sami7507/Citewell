# Template for Streamlit Community Cloud's secrets manager.
#
# Locally the app reads .env instead (see config/.env.example). On Streamlit
# Community Cloud, open your app's Settings -> Secrets and paste the lines below
# with real values. The app copies them into environment variables at startup,
# so no code changes are needed between local and deployed use.
#
# Never commit a real secrets.toml.

GROQ_API_KEY = "gsk_your_actual_key_here"
GROQ_MODEL = "openai/gpt-oss-120b"
EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
TOP_K = "2"
