# Template for Streamlit secrets.
#
# On Streamlit Community Cloud: open your app, then the app menu -> Settings -> Secrets,
# paste the lines below with real values, and save. The app restarts.
# Locally: save this as .streamlit/secrets.toml (that file is git-ignored). The API key can
# instead live in .env (see config/.env.example).
#
# Never commit a real secrets.toml.

GROQ_API_KEY = "gsk_your_actual_key_here"

# Optional
GROQ_MODEL = "openai/gpt-oss-120b"
# GROQ_FALLBACK_MODEL = ""   # optional: a second model id your Groq account can use
MAX_QUESTIONS_PER_SESSION = "30"
MAX_QUESTIONS_SIGNED_IN = "100"
# REQUIRE_LOGIN = "false"    # "true" makes visitors sign in before asking anything

# ---------------------------------------------------------------------------------------
# Optional sign-in (Streamlit built-in OpenID Connect). Leave this whole section out and
# the app simply has no sign-in. See the README section "Sign-in with Google".
# ---------------------------------------------------------------------------------------
# [auth]
# redirect_uri = "https://citewell.streamlit.app/oauth2callback"   # locally: http://localhost:8501/oauth2callback
# cookie_secret = "a-long-random-string"   # generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# [auth.google]
# client_id = "xxxxxxxx.apps.googleusercontent.com"
# client_secret = "xxxxxxxx"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
#
# Phone-number sign-in: add a second provider named "phone" that points at an identity
# provider offering SMS one-time codes (for example Auth0, Firebase or Clerk). Its button
# then appears automatically.
# [auth.phone]
# client_id = "..."
# client_secret = "..."
# server_metadata_url = "https://YOUR-PROVIDER/.well-known/openid-configuration"
